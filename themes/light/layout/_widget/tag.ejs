<% if (site.tags.length){ %>
<div class="widget tag tag-summary">
  <h3 class="title"><%= __('popular_tags') %></h3>
  <ul class="entry tag-summary__list">
  <% taxonomy_items('tags').slice(0, 20).forEach(function(item){ %>
    <li><a href="<%- url_for(item.path) %>"><span><%= item.name %></span><small><%= item.count %></small></a></li>
  <% }); %>
  </ul>
  <a class="widget-directory-link" href="<%- url_for('tags/') %>"><%= __('all_tags') %></a>
</div>
<% } %>
