<% if (page.comments && theme.comment_provider == "facebook" && theme.facebook) { %>
<section id="comment">
  <p class="title"><%= __('comment') %></p>
  <%- partial('_partial/facebook_comment', {fbConfig: theme.facebook, url: page.permalink}) %>
</section>
<% } else if (page.comments && theme.comment_provider == "disqus" && config.disqus_shortname) { %>
<section id="comment">
  <p class="title"><%= __('comment') %></p>
  <div id="disqus_thread">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>
