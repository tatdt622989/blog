#header
  text-shadow 0 0 1px #fff
  margin 50px auto
  @media (max-width: 480px)
    display flex
    flex-direction column
    margin 30px auto 20px auto
  a
    color #22a779
    font-weight bold
    &:hover
      color #22a779
      text-decoration none

  .logo
    max-width 140px
    a
      display flex
      img
        width 100%
    
  h1
    font-weight normal
    font-size 2.5em
    line-height 1

  h2
    font-weight normal
    font-size 0.9em
    line-height 1
    margin-top 10px
  
  #main-nav
    font-family font-title
    line-height 2.5em
    ul
      list-style none
      @media (max-width: 480px)
        display flex
        flex-wrap wrap
        align-items center
      li
        float left
        margin-left 30px
        @media (max-width: 480px)
          margin 0 10px
        a
          font-size 18px
          color #3f3f3f
          transition all 0.3s ease
          &:hover
            opacity 0.8

      li.language-switcher
        position relative
        z-index 30
        white-space nowrap
        line-height 1

        @media (max-width: 480px)
          margin-left auto

        .language-switcher__menu
          position relative

          &[open]
            summary
              color #177c5d
              border-color rgba(34, 167, 121, 0.55)
              background rgba(255, 255, 255, 0.96)
              box-shadow 0 8px 24px rgba(28, 91, 70, 0.14)

            .language-switcher__chevron
              transform rotate(180deg)

            .language-switcher__panel
              animation language-menu-in 160ms ease-out

        summary
          box-sizing border-box
          min-width 112px
          min-height 40px
          display flex
          align-items center
          justify-content center
          gap 8px
          padding 0 12px
          color #31564b
          background rgba(255, 255, 255, 0.72)
          border 1px solid rgba(34, 167, 121, 0.25)
          border-radius 999px
          box-shadow 0 4px 14px rgba(44, 105, 85, 0.08)
          cursor pointer
          list-style none
          transition color 160ms ease, border-color 160ms ease, background 160ms ease, box-shadow 160ms ease

          &::-webkit-details-marker
            display none

          &:hover
            color #177c5d
            border-color rgba(34, 167, 121, 0.5)
            background rgba(255, 255, 255, 0.92)

          &:focus-visible
            outline 3px solid rgba(34, 167, 121, 0.25)
            outline-offset 3px

        .language-switcher__globe
          width 18px
          height 18px
          display flex
          color #22a779

          svg
            width 18px
            height 18px
            fill none
            stroke currentColor
            stroke-width 1.7
            stroke-linecap round
            stroke-linejoin round

        .language-switcher__current
          font-size 14px
          font-weight 600
          letter-spacing 0.02em

        .language-switcher__chevron
          width 6px
          height 6px
          margin-top -3px
          border-right 1.5px solid currentColor
          border-bottom 1.5px solid currentColor
          transform rotate(45deg)
          transition transform 160ms ease

        .language-switcher__panel
          box-sizing border-box
          width 196px
          position absolute
          top calc(100% + 10px)
          right 0
          padding 7px
          background rgba(255, 255, 255, 0.98)
          border 1px solid rgba(34, 167, 121, 0.2)
          border-radius 15px
          box-shadow 0 18px 42px rgba(30, 75, 60, 0.18), 0 3px 10px rgba(30, 75, 60, 0.08)
          overflow hidden

          &::before
            content ''
            position absolute
            top 7px
            bottom 7px
            left 7px
            width 3px
            border-radius 99px
            background linear-gradient(to bottom, #22a779 0 50%, #89d6bb 50% 100%)

        a.language-switcher__option
          box-sizing border-box
          min-height 44px
          display flex
          align-items center
          justify-content space-between
          gap 18px
          margin-left 5px
          padding 0 10px 0 12px
          color #3f4d48
          font-size 14px
          font-weight 500
          line-height 1.25
          border-radius 10px
          transition color 140ms ease, background 140ms ease, transform 140ms ease

          &:hover
            color #177c5d
            background #f1faf7
            opacity 1
            text-decoration none
            transform translateX(2px)

          &:focus-visible
            outline 2px solid rgba(34, 167, 121, 0.5)
            outline-offset -2px

          &.is-active
            color #126b50
            background #eaf7f2
            font-weight 700

            .language-switcher__code
              color #fff
              background #22a779

        .language-switcher__code
          min-width 28px
          padding 4px 5px
          color #71817b
          background #f1f5f3
          border-radius 7px
          font-size 10px
          font-weight 700
          line-height 1
          letter-spacing 0.08em
          text-align center

        @media (max-width: 480px)
          summary
            min-width 118px
            min-height 44px
            padding 0 13px

          .language-switcher__panel
            width calc(100vw - 40px)
            max-width 196px
            top calc(100% + 8px)

          a.language-switcher__option
            min-height 48px

@keyframes language-menu-in
  from
    opacity 0
    transform translateY(-5px) scale(0.98)
  to
    opacity 1
    transform translateY(0) scale(1)

@media (prefers-reduced-motion: reduce)
  #header #main-nav li.language-switcher
    .language-switcher__menu[open] .language-switcher__panel
      animation none

    .language-switcher__chevron,
    a.language-switcher__option,
    summary
      transition none
