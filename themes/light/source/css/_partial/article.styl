icon-size = 32px
icon-gap = 25px

article
  background #fff
  border-radius 10px
  &.page
    padding-left 20px
    .icon
      display none

  &.post
    .icon
      &:before
        content '\f016'

  &.photo
    .icon
      &:before
        content '\f030'

  &.link
    .icon
      &:before
        content '\f0c1'

    .title
      a
        &:after
          content '\f08e'
          color color-meta
          font 12px font-icon
          padding-left 10px
          vertical-align super

  .post-content
    padding 20px 20px 15px 20px
    margin-bottom 50px
    position relative
    @media screen and (max-width: 600px)
      padding-left 20px
    header>.title 
      font-size 28px
      font-weight 500
      @media screen and (max-width: 480px)
        font-size 24px
    img
      border-radius 10px
    .toc
      background #f4f4f4
      border-radius 10px
      padding 10px 14px
      margin-top 10px
      .toc-title
        font-size 20px
        font-weight 500
        margin-bottom 3px
      ul
        list-style none
        padding-left 0
        margin 0
        li
          position relative
          padding-left 16px
          line-height 1.5
          letter-spacing 0.7px
          &:before
            content ''
            width 5px
            height 5px
            background color-dark
            border-radius 50%
            position absolute
            left 0
            top 11px

  .gallery
    overflow hidden
    position relative
    &:hover
      .control
        opacity 1

    img
      min-width 100%
      max-width 100%
      height auto
      position absolute
      top 0
      left 0
      opacity 0

    .control
      opacity 0
      transition 0.3s

    .prev, .next
      position absolute
      top 0
      width 50%
      height 100%
      cursor pointer
      &:before
        position absolute
        font 24px/1 font-icon
        text-align center
        width 24px
        text-shadow 0 0 15px rgba(0,0,0,0.5)
        color #fff
        margin-top -12px
        top 50%

    .prev
      left 0
      &:before
        content '\f053'
        left 10px

    .next
      right 0
      &:before
        content '\f054'
        right 10px

  header
    .icon
      width icon-size
      height icon-size
      margin-right icon-gap
      position absolute
      top 20px
      left 20px
      color color-link
      @media screen and (max-width: 600px)
        display none
      &:before
        position absolute
        font 32px font-icon
        top 0
        left 0
        width 32px
        text-align center

    time
      color #22a779
      font 0.9em font-title
      margin-bottom 5px
      display block
      line-height 1
      a
        color #22a779
        font-size 20px
        font-weight bold

    .title
      font-weight normal
      a
        color color-font
        &:hover
          color color-link
          text-decoration none

  .entry
    text-align justify
    line-height 1.6
    
    p, blockquote, ul, ol, dl, table, iframe, h3, h4, h5, h6, .video-container
      margin-top 15px
      font-size 18px
      letter-spacing: 0.6px
      line-height 1.8
      text-align left

    .topImgWrap
      display flex

    h2
      font-size 24px
    
    hr
      border 0
      border-top solid 1px #ddd

    .tableWrap 
      width 100%
      overflow auto

    .mermaid-box
      position relative
      margin 28px 0
      background #ffffff !important
      border 1px solid #e2e8f0
      border-radius 12px
      box-shadow 0 4px 14px rgba(0, 0, 0, 0.04)
      overflow hidden
      transition all 0.2s ease
      &:hover
        border-color #38bdf8
        box-shadow 0 6px 20px rgba(56, 189, 248, 0.12)
      
      .mermaid-header
        display flex
        justify-content space-between
        align-items center
        padding 10px 14px
        background #f8fafc !important
        border-bottom 1px solid #e2e8f0
        font-size 13px
        color #64748b
        font-weight 500
        user-select none
        .mermaid-title
          display flex
          align-items center
          gap 6px
          font-weight 600
          color #334155
        .mermaid-tools
          display inline-flex
          align-items center
          gap 6px

          .zoom-level
            font-size 12px
            color #64748b
            font-weight 600
            min-width 40px
            text-align right
            margin-right 2px

          .mermaid-btn
            display inline-flex
            align-items center
            justify-content center
            height 26px
            padding 0 8px
            background #e2e8f0
            color #1e293b
            border 0
            border-radius 6px
            font-size 12px
            font-weight 500
            cursor pointer
            transition all 0.15s ease
            user-select none
            &:hover
              background #cbd5e1
              color #0f172a
            &:active
              background #94a3b8

    .mermaid-viewport
      width 100%
      background #ffffff !important
      overflow-x auto
      overflow-y hidden
      position relative
      padding 24px 12px
      box-sizing border-box
      text-align center
      -webkit-overflow-scrolling touch

    pre.mermaid
    .mermaid
      text-align center
      margin 0 auto !important
      padding 0 !important
      background transparent !important
      border none !important
      box-shadow none !important
      box-sizing border-box
      display block
      font-size 15px
      line-height 1.4
      white-space normal
      font-family inherit
      svg
        display inline-block
        margin 0 auto
        max-width 100%
        height auto

    .blog-chart
      position relative
      max-width 100%
      overflow hidden
      margin 28px 0
      padding 22px 24px 18px
      background #ffffff !important
      border 1px solid #e2e8f0
      border-radius 14px
      box-shadow 0 4px 16px rgba(15, 23, 42, 0.05)
      transition border-color 0.2s ease, box-shadow 0.2s ease
      box-sizing border-box
      &:hover
        border-color #94a3b8
        box-shadow 0 8px 22px rgba(15, 23, 42, 0.08)

      .blog-chart__header
        margin-bottom 14px

      .blog-chart__title
        font-size 18px
        font-weight 700
        color #0f172a
        line-height 1.35
        margin 0

      .blog-chart__subtitle
        margin-top 4px
        font-size 13.5px
        color #64748b
        line-height 1.45

      .blog-chart__canvas-wrap
        position relative
        width 100%
        height var(--chart-height, 340px)

      .blog-chart__canvas
        display block
        width 100% !important
        height 100% !important

      .blog-chart__range-wrap
        width 100%
        padding 6px 0 2px

      .blog-chart__range-svg
        display block
        width 100%
        height auto
        overflow visible

      .blog-chart__range-segment
        cursor pointer
        outline none
        transition opacity 0.15s ease
        &:hover
        &:focus
          opacity 0.9

      .blog-chart__range-tooltip
        margin-top 10px
        padding 8px 12px
        border-radius 8px
        background #f8fafc
        border 1px solid #e2e8f0
        font-size 13px
        color #475569
        line-height 1.45
        &.is-active
          background #f0fdf4
          border-color #a7f3d0
          color #065f46
          font-weight 600

      .blog-chart__note
        margin-top 12px
        padding-top 10px
        border-top 1px solid #f1f5f9
        font-size 12.5px
        color #64748b
        line-height 1.5

      .blog-chart__fallback
        padding 18px
        text-align center
        color #64748b
        font-size 13.5px

      @media screen and (max-width: 640px)
        padding 16px 14px 14px
        margin 22px 0
        .blog-chart__title
          font-size 16px
        .blog-chart__subtitle
          font-size 12.5px
        .blog-chart__canvas-wrap
          height calc(var(--chart-height, 340px) * 0.85)
          min-height 260px





    table
      border-collapse collapse
      border-spacing 0
      empty-cells show
      border 1px solid lighten(color-border, 2)
      width 100%

      th
        white-space nowrap
        color color-font
        font-weight 600

      td,
      th
        border 1px solid lighten(color-border, 2)
        padding 8px 16px
        text-align left

        @media screen and (max-width: 600px)
          padding 8px

        span.material-icons
          vertical-align top
          cursor pointer

    figure.highlight
      table
        border none
        width 100%
        border-collapse collapse
        table-layout fixed
        overflow-wrap break-word

    blockquote
      border-top 1px solid color-border
      border-bottom 1px solid color-border
      font-style italic
      font-family font-serif
      font-size 1.2em
      padding 0 30px 15px
      text-align center
      footer
        border-top none
        font-size 0.8em
        line-height 1
        margin 20px 0 0
        padding-top 0
        cite
          &:before
            content '—'
            color #ccc
            padding 0 0.5em

    code, pre
      font-family font-mono

    code
      background rgba(0, 0, 0, 0.06)
      color #c7254e
      padding 2px 5px
      margin 0 2px
      font-size 0.9em
      border-radius 3px
      word-break break-word

    pre
      background #1F1F1F
      border 1px solid color-border
      margin-top 15px
      overflow auto
      padding 7px 15px
      border-radius 2px
      code
        background none
        color inherit
        padding 0
        margin 0
        border none
        border-radius 0

    ul, ol, dl
      margin-left 20px
      ul, ol, dl
        margin-top 0

    h1, h2
      font-weight 500
      border-bottom 1px solid color-border
      padding-bottom 10px
      margin-top 20px
      text-align left

    h3, h4, h5, h6
      font-weight normal
    h3
      font-weight bold
      padding-top 6px

    img, video
      max-width 100%
      height auto
      border none
      display block
      margin 15px auto

    .img-group
      display flex
      flex-wrap wrap
      gap 10px
      align-items flex-start
      img
        width auto
      a
        width auto
      @media screen and (max-width: 600px)
        flex-direction column
        img
          width 100% !important
        a
          width 100%

    a
      display inline-flex
      width 100%

    .post-cover-frame
      aspect-ratio 16 / 9
      overflow hidden
      border-radius 10px
      > .topImgWrap
        display flex
        width 100%
        height 100%
      img
        display block
        width 100%
        height 100%
        object-fit cover

    iframe
      border none

    .caption
      display block
      margin-top 5px
      color color-meta
      position relative
      font-size 0.9em
      padding-left 25px
      &:before
        content '\f040'
        position absolute
        font 1.3em font-icon
        position absolute
        left 0
        top 3px

    .video-container
      position relative
      padding-bottom 56.25%
      padding-top 30px
      height 0
      overflow hidden
      iframe, object, embed
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        margin-top 0

    .pullquote
      float right
      border none
      padding 0
      margin 1em 0 0.5em 1.5em
      text-align left
      width 45%
      font-size 1.5em

  footer
    margin-top 15px
    padding-top 10px
    border-top 1px solid color-border
    color color-meta
    font-size 0.9em
    line-height 16px
    position relative
    min-height 16px
    a
      color color-meta
      &:hover
        color color-link
        text-decoration none
      &:before
        font 1.1em font-icon
        padding-right 10px
        vertical-align middle

      &.more-link
        font-size 16px
        padding-top 10px
        display inline-block
        &:before
          content '\f054'

      &.comment-link
        &:before
          content '\f075'

    .categories, .tags
      position relative
      padding-left 25px
      margin 5px 0
      &:before
        position absolute
        font 1.1em font-icon

    .categories
      &:before
        content '\f07b'
        top 2px
        left 1px

    .tags
      &:before
        content '\f02b'
        top 3px
        left 2px

    .addthis
      margin-top 15px
      iframe
        margin-top 0

  .related-posts
    margin-top 35px
    padding-top 25px
    border-top 1px solid color-border

    .related-posts-title
      font-size 18px
      font-weight 600
      color color-dark
      margin 0 0 18px 0
      padding-left 12px
      border-left 4px solid color-link
      line-height 1.3

    .related-posts-grid
      display grid
      grid-template-columns repeat(3, 1fr)
      gap 16px

      @media screen and (max-width: 640px)
        grid-template-columns 1fr
        gap 12px

    .related-post-card
      background #fff
      border 1px solid #e8e8e8
      border-radius 8px
      overflow hidden
      transition transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease
      display flex
      flex-direction column

      &:hover
        transform translateY(-3px)
        box-shadow 0 6px 16px rgba(0, 0, 0, 0.08)
        border-color lighten(color-link, 30%)

        .related-post-cover img
          transform scale(1.05)

        .related-post-item-title
          color color-link

    .related-post-link
      display flex
      flex-direction column
      width 100%
      height 100%
      text-decoration none
      color inherit

    .related-post-cover
      position relative
      width 100%
      aspect-ratio 16 / 9
      background #f3f4f6
      overflow hidden

      img
        width 100%
        height 100%
        object-fit cover
        margin 0
        border-radius 0
        display block
        transition transform 0.3s ease

      .related-post-placeholder
        width 100%
        height 100%
        display flex
        align-items center
        justify-content center
        background linear-gradient(135deg, #eaf5f1 0%, #d8eee7 100%)
        color color-link
        font-size 13px
        font-weight 600
        padding 10px
        text-align center
        box-sizing border-box

    .related-post-info
      padding 12px
      display flex
      flex-direction column
      flex 1

      .related-post-tag
        font-size 11px
        color color-link
        font-weight 600
        text-transform uppercase
        margin-bottom 6px
        letter-spacing 0.5px
        line-height 1.2

      .related-post-item-title
        font-size 14px
        font-weight 600
        line-height 1.45
        color color-font
        margin 0 0 8px 0
        padding 0
        border none
        display -webkit-box
        -webkit-line-clamp 2
        -webkit-box-orient vertical
        overflow hidden
        transition color 0.2s ease

      .related-post-date
        font-size 12px
        color color-meta
        margin-top auto
        line-height 1


// Fixed ad slots on posts, sidebar, and feeds (scripts/article-ads.js). Slots reserve space to
// limit layout shift. The label follows the ad in the HTML so an unfilled ad hides its label too;
// column-reverse shows the label above the ad. Outer .site-ad wrappers keep 0 padding/margin so
// unfilled cards collapse completely with plain CSS sibling selectors.
.article-ad,
.site-ad
  display flex
  flex-direction column-reverse
  overflow hidden
  ins.adsbygoogle
    width 100%
    min-height 120px
    &[data-ad-status="unfilled"]
      display none !important
      & + .article-ad-label
        display none !important

.article-ad
  margin 2em 0

.article-ad--article ins.adsbygoogle
  min-height 200px

.site-ad--feed
  margin 0
  padding 0
  background transparent
  .article-ad-label
    background #fff
    border-radius 10px 10px 0 0
    padding 12px 0 4px
    margin-bottom 0
    @media screen and (max-width: 600px)
      border-radius 0
  ins.adsbygoogle
    box-sizing border-box
    background #fff
    border-radius 0 0 10px 10px
    padding 4px 0 16px
    margin-bottom 30px
    box-shadow 0 2px 6px rgba(0, 0, 0, 0.04)
    @media screen and (max-width: 600px)
      border-radius 0

.article-ad-label
  font-size 11px
  letter-spacing 0.08em
  color color-meta
  text-align center
  margin-bottom 4px
