#sidebar
  width 270px
  line-height 1.8em
  position sticky
  top 20px
  @media screen and (max-width: 900px)
    position static
    float none
    width 100%
  .widget
    background #fff
    margin-bottom 30px
    border-radius 10px
    word-wrap break-word
    .title
      padding 15px 20px
      font-size 1em
      border-bottom 1px solid color-border
      font-weight normal

    .entry
      font-size 1.2em
      padding 15px 20px
      li a
        color #22a779

    ul, ol, dl
      list-style none
      ul, ol, dl
        list-style disc
        margin-left 20px

  .search
    margin-bottom 30px

  .site-ad--sidebar
    background transparent
    margin-bottom 0
    border-radius 0
    .article-ad-label
      background #fff
      border-radius 10px 10px 0 0
      padding 10px 0 4px
      margin-bottom 0
    ins.adsbygoogle
      box-sizing border-box
      background #fff
      border-radius 0 0 10px 10px
      padding 4px 0 12px
      margin-bottom 30px
      min-height 250px
      @media screen and (max-width: 900px)
        min-height 120px

  .tag
    small
      margin-left 15px
      color color-meta
      &:before
        content '('
      &:after
        content ')'

  .twitter
    li
      border-bottom 1px solid color-border
      padding 15px 20px
      font-size 0.9em
      &:last-of-type
        border-bottom none
    small
      display block
      margin-top 10px
      color color-meta
      line-height 1

  .tagcloud
    .entry
      padding-right 5px
    a
      margin-right 10px
      display inline-block