.start-here
  background #fff
  border 1px solid #cddfd5
  border-radius 10px
  padding 24px 28px
  margin 0 0 24px
  &__heading
    display flex
    align-items flex-start
    justify-content space-between
    gap 12px
    h2
      font-size 22px
      font-weight 700
      color #234d39
      margin-bottom 6px
    p
      font-size 14px
      line-height 1.6
      color #53645c
  .rss-link
    color #166947
    white-space nowrap
    padding 6px 0
    font-size 13px
  &__guides
    list-style none
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 0 28px
    margin-top 12px
    li
      min-width 0
      border-top 1px solid #e3ece6
  &__link
    display block
    padding 14px 0
    &:hover
      text-decoration none
      .start-here__label
        text-decoration underline
    &:focus-visible
      outline 2px solid #16754f
      outline-offset 4px
  &__label
    display block
    color #166947
    font-size 16px
    font-weight 700
    line-height 1.5
  &__description
    display block
    color #53645c
    font-size 13px
    line-height 1.7
    margin-top 3px
  @media screen and (max-width: 520px)
    padding 20px
    &__heading
      flex-wrap wrap
    &__guides
      grid-template-columns 1fr

#pagination
  a
    display block
    padding 8px 14px
    border-radius 5px
    background color-link
    color #fff
    font-family font-title
    font-weight 500
    text-shadow 0 0 1px #fff
    margin-bottom 50px
    &:hover
      background color-dark
      color color-link
      text-decoration none
      text-shadow none

  .prev
    &:before
      content '\f053'
      padding-right 10px
      font-family font-icon

  .next
    &:after
      content '\f054'
      padding-left 10px
      font-family font-icon
