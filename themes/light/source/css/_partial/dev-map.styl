dev-map-border = #cddfd5
dev-map-divider = #e3ece6
dev-map-heading = #234d39
dev-map-text = #53645c
dev-map-muted = #7a8a82
dev-map-accent = #22a779
dev-map-pin = #d9573c

#main-col.main-col--full
  width 100%
  margin-right 0
  float none
  #wrapper
    margin-right 0

.dev-map
  color dev-map-text
  h1, h2, h3, p
    margin 0
  ol
    margin 0
    padding 0
    list-style none
  a:hover
    text-decoration none
  time
    display inline
    color inherit
    font-size inherit

.dev-map__hero
  background #fff
  border 1px solid dev-map-border
  border-radius 10px
  padding 34px 40px 26px

.dev-map__title
  color dev-map-heading
  font-weight 700

.dev-map__title-main
  display block
  font-size 40px
  font-weight 900
  line-height 1.25

.dev-map__title-sub
  display block
  margin-top 8px
  color #2f6b51
  font-size 22px
  line-height 1.5

.dev-map__lead
  max-width 820px
  margin-top 14px !important
  font-size 16px
  line-height 1.8

.dev-map__lead--short
  display none

.dev-map__route
  margin-top 22px
  padding-top 20px
  border-top 1px solid dev-map-divider

.dev-map__tabs
  display inline-flex
  gap 4px
  padding 4px
  background #f3f8f5
  border 1px solid dev-map-border
  border-radius 999px

.dev-map__tab
  display flex
  align-items baseline
  gap 8px
  padding 10px 24px
  border 0
  border-radius 999px
  background transparent
  color dev-map-heading
  font inherit
  font-size 16px
  font-weight 700
  cursor pointer
  span
    color dev-map-muted
    font-size 12px
    font-weight 500
  &.is-active
    background dev-map-heading
    color #fff
    span
      color #b9d8c8
  &:focus-visible
    outline 2px solid dev-map-accent
    outline-offset 2px

.dev-map__hint
  display inline-block
  margin-left 16px !important
  color dev-map-pin
  font-size 14px
  font-weight 700
  .has-here &
    visibility hidden

.dev-map__stops
  position relative
  display grid
  grid-template-columns repeat(5, minmax(0, 1fr))
  margin-top 38px !important
  &:before
    content ""
    position absolute
    top 17px
    left 10%
    right 10%
    height 3px
    background repeating-linear-gradient(90deg, dev-map-accent 0 10px, transparent 10px 18px)
    opacity .55

.dev-map__stop
  position relative
  display flex
  flex-direction column
  align-items center
  gap 10px
  text-align center
  &:focus-visible
    outline 2px solid dev-map-accent
    outline-offset 4px
    border-radius 8px
  &:hover .dev-map__dot
    transform scale(1.08)

.dev-map__dot
  position relative
  z-index 1
  display grid
  place-items center
  width 36px
  height 36px
  border 2px solid dev-map-accent
  border-radius 50%
  background #fff
  color dev-map-accent
  font-weight 700
  transition transform .15s
  .is-here &
    background dev-map-accent
    color #fff
    box-shadow 0 0 0 6px rgba(34, 167, 121, .18)
    transform scale(1.1)

.dev-map__stop-label
  color dev-map-heading
  font-size 15px
  font-weight 700
  line-height 1.4

.dev-map__short
  display none

.dev-map__pin, .dev-map__badge
  display none
  align-items center
  gap 4px
  padding 3px 10px 3px 7px
  border-radius 999px
  background dev-map-pin
  color #fff
  font-size 12px
  font-weight 700
  white-space nowrap

.dev-map__pin
  position absolute
  top -34px
  .is-here &
    display inline-flex

.dev-map__meta
  margin-top 18px !important
  color dev-map-muted
  font-size 13px

.dev-map__section-head
  display flex
  align-items baseline
  gap 14px
  margin 32px 0 14px
  h2
    color dev-map-heading
    font-size 21px
  p
    font-size 14px

.dev-map__featured-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 20px

.dev-map-card
  display flex
  flex-direction column
  overflow hidden
  background #fff
  border 1px solid dev-map-border
  border-radius 10px
  transition border-color .15s, transform .15s
  &:hover
    border-color dev-map-accent
    transform translateY(-2px)
  &:hover .dev-map-card__title
    text-decoration underline
  &:focus-visible
    outline 2px solid dev-map-accent
    outline-offset 2px

.dev-map-card__media
  position relative
  display block
  aspect-ratio 16 / 9
  overflow hidden
  background dev-map-divider
  img
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    max-width none
    margin 0
    object-fit cover

.dev-map-card__body
  display flex
  flex 1
  flex-direction column
  gap 8px
  padding 16px 18px 18px

.dev-map-card__title
  color dev-map-heading
  font-size 15px
  font-weight 700
  line-height 1.5
  display -webkit-box
  -webkit-line-clamp 2
  -webkit-box-orient vertical
  overflow hidden
  .dev-map-card--feature &
    font-size 17px
    -webkit-line-clamp 3

.dev-map-card__solves
  color dev-map-text
  font-size 13px
  line-height 1.7
  .dev-map-card--feature &
    font-size 14px

.dev-map .dev-map-card__date
  margin-top auto
  color dev-map-muted
  font-size 12px

.dev-map__tracks
  margin-top 36px

.dev-map__track-title
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip rect(0 0 0 0)
  white-space nowrap

.dev-map__stage
  display grid
  grid-template-columns 220px minmax(0, 1fr)
  gap 24px
  padding 28px 0
  border-top 1px solid dev-map-border
  scroll-margin-top 16px
  &:first-of-type
    border-top 0
  &.is-here
    padding 26px 22px
    background rgba(255, 255, 255, .55)
    border 2px solid dev-map-accent
    border-radius 12px

.dev-map__stage-num
  display flex
  align-items center
  color dev-map-accent
  font-size 14px
  font-weight 700
  letter-spacing .06em
  .dev-map__badge
    margin-left 8px
  .is-here & .dev-map__badge
    display inline-flex

.dev-map__stage-head
  h3
    margin 6px 0 !important
    color dev-map-heading
    font-size 22px

.dev-map__stage-formal
  display inline-block
  padding 1px 8px
  border 1px solid dev-map-border
  border-radius 999px
  color dev-map-muted
  font-size 12px

.dev-map__stage-note
  margin-top 10px !important
  font-size 14px
  line-height 1.7

.dev-map__items
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 16px
  align-content start

.dev-map__more-grid
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 16px

.dev-map__closing
  display flex
  align-items center
  justify-content space-between
  gap 24px
  margin-top 36px
  padding 28px 36px
  border-radius 10px
  background dev-map-heading
  color #fff
  h2
    margin-bottom 6px !important
    font-size 20px
  p
    color #c9e2d5
    font-size 14px
    line-height 1.7

.dev-map__closing-links
  display flex
  flex-shrink 0
  gap 12px
  a
    padding 10px 18px
    border 1px solid #6f9b85
    border-radius 999px
    color #fff
    font-size 14px
    font-weight 700
    &:first-child
      background #fff
      border-color #fff
      color dev-map-heading

@media screen and (max-width: 1100px)
  .dev-map__stage
    grid-template-columns 1fr
    gap 14px
  .dev-map__items
    grid-template-columns repeat(2, minmax(0, 1fr))
  .dev-map__more-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

@media screen and (max-width: 720px)
  .dev-map__hero
    padding 20px 18px 18px
  .dev-map__title-main
    font-size 22px
  .dev-map__title-sub
    margin-top 6px
    font-size 14px
    letter-spacing -.01em
  .dev-map__lead
    margin-top 10px !important
    font-size 14px
    line-height 1.75
  .dev-map__lead--full
    display none
  .dev-map__lead--short
    display block
  .dev-map__route
    margin-top 14px
    padding-top 14px
  .dev-map__tabs
    display flex
    width 100%
  .dev-map__tab
    flex 1
    justify-content center
    padding 10px 6px
    font-size 14.5px
  .dev-map__hint
    display block
    margin 6px 0 0 !important
    font-size 12px
    text-align center
  .dev-map__stops
    margin-top 26px !important
    &:before
      top 14px
  .dev-map__stop
    gap 6px
  .dev-map__dot
    width 30px
    height 30px
    font-size 13px
  .dev-map__stop-label
    font-size 13px
  .dev-map__long
    display none
  .dev-map__short
    display inline
  .dev-map__pin
    top -30px
    padding 2px 8px 2px 6px
    font-size 11px
  .dev-map__meta
    margin-top 12px !important
    font-size 12px
  .dev-map__section-head
    flex-direction column
    gap 4px
    margin 20px 0 10px
    h2
      font-size 18px
    p
      font-size 13px
  .dev-map__featured .dev-map__section-head p
    display none
  .dev-map__featured-grid
    grid-auto-flow column
    grid-template-columns none
    grid-auto-columns 82%
    gap 12px
    margin 0 -16px
    padding 0 16px 4px
    overflow-x auto
    scroll-snap-type x mandatory
    scrollbar-width none
    .dev-map-card
      scroll-snap-align start
  .dev-map__tracks
    margin-top 24px
  .dev-map__stage
    padding 22px 0
    &.is-here
      padding 18px 14px
  .dev-map__stage-head h3
    display inline
    margin 0 8px 0 0 !important
    font-size 19px
  .dev-map__stage-note
    margin-top 6px !important
    font-size 13px
  .dev-map__items, .dev-map__more-grid
    grid-template-columns 1fr
    gap 10px
  .dev-map-card--entry
    flex-direction row
    .dev-map-card__media
      flex 0 0 112px
      aspect-ratio auto
      min-height 84px
    .dev-map-card__body
      gap 4px
      padding 10px 12px
    .dev-map-card__title
      font-size 14px
    .dev-map-card__solves
      font-size 12.5px
      line-height 1.6
      display -webkit-box
      -webkit-line-clamp 2
      -webkit-box-orient vertical
      overflow hidden
    .dev-map-card__date
      display none
  .dev-map-card--feature .dev-map-card__title
    font-size 16px
  .dev-map__closing
    flex-direction column
    align-items flex-start
    padding 22px 20px
  .dev-map__closing-links
    flex-wrap wrap
    width 100%
    a
      flex 1
      padding 10px 12px
      text-align center
